<?xml version="1.0"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <DocumentProperties xmlns="urn:schemas-microsoft-com:office:office">
  <Author>tafasa</Author>
  <LastAuthor>tafasa</LastAuthor>
  <Created>2024-01-01T00:00:00Z</Created>
  <Version>16.00</Version>
 </DocumentProperties>
 <OfficeDocumentSettings xmlns="urn:schemas-microsoft-com:office:office">
  <AllowPNG/>
 </OfficeDocumentSettings>
 <ExcelWorkbook xmlns="urn:schemas-microsoft-com:office:excel">
  <WindowHeight>11865</WindowHeight>
  <WindowWidth>28800</WindowWidth>
  <WindowTopX>32767</WindowTopX>
  <WindowTopY>32767</WindowTopY>
  <ProtectStructure>False</ProtectStructure>
  <ProtectWindows>False</ProtectWindows>
 </ExcelWorkbook>
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Bottom"/>
   <Borders/>
   <Font ss:FontName="Aptos Narrow" x:Family="Swiss" ss:Size="11"
    ss:Color="#000000"/>
   <Interior/>
   <NumberFormat/>
   <Protection/>
  </Style>
 </Styles>
 <Worksheet ss:Name="Meals">
  <Table ss:ExpandedColumnCount="8" ss:ExpandedRowCount="3" x:FullColumns="1"
   x:FullRows="1" ss:DefaultRowHeight="15">
   <Column ss:Width="105"/>
   <Column ss:Width="231.75"/>
   <Column ss:Width="28.5"/>
   <Column ss:Width="266.25"/>
   <Column ss:Width="54"/>
   <Column ss:Width="73.5"/>
   <Column ss:Width="390"/>
   <Column ss:Width="419.25"/>
   <Row>
    <Cell><Data ss:Type="String">Name</Data></Cell>
    <Cell><Data ss:Type="String">Description</Data></Cell>
    <Cell><Data ss:Type="String">Price</Data></Cell>
    <Cell><Data ss:Type="String">Image</Data></Cell>
    <Cell><Data ss:Type="String">CategoryId</Data></Cell>
    <Cell><Data ss:Type="String">CategoryName</Data></Cell>
    <Cell><Data ss:Type="String">Ingredients</Data></Cell>
    <Cell><Data ss:Type="String">PreparationSteps</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Grilled Chicken Salad</Data></Cell>
    <Cell><Data ss:Type="String">Fresh greens with grilled chicken and vinaigrette</Data></Cell>
    <Cell><Data ss:Type="Number">12.5</Data></Cell>
    <Cell><Data ss:Type="String">https://example.com/images/grilled-chicken-salad.jpg</Data></Cell>
    <Cell><Data ss:Type="Number">1</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">Mixed Greens|100|g;Grilled Chicken|150|g;Vinaigrette|2|tbsp</Data></Cell>
    <Cell><Data ss:Type="String">Season the chicken;Grill for 6 minutes per side;Toss with greens and dressing</Data></Cell>
   </Row>
   <Row>
    <Cell><Data ss:Type="String">Veggie Pasta</Data></Cell>
    <Cell><Data ss:Type="String">Whole grain pasta with roasted vegetables</Data></Cell>
    <Cell><Data ss:Type="Number">9.75</Data></Cell>
    <Cell><Data ss:Type="String">https://example.com/images/veggie-pasta.jpg</Data></Cell>
    <Cell><Data ss:Type="String"></Data></Cell>
    <Cell><Data ss:Type="String">فطور</Data></Cell>
    <Cell><Data ss:Type="String">Whole Grain Pasta|120|g;Zucchini|80|g;Bell Pepper|60|g;Tomato Sauce|150|ml</Data></Cell>
    <Cell><Data ss:Type="String">Boil pasta until al dente;Roast vegetables for 15 minutes;Combine with sauce and pasta</Data></Cell>
   </Row>
  </Table>
  <WorksheetOptions xmlns="urn:schemas-microsoft-com:office:excel">
   <Selected/>
   <Panes>
    <Pane>
     <Number>3</Number>
     <ActiveRow>1</ActiveRow>
     <ActiveCol>4</ActiveCol>
    </Pane>
   </Panes>
   <ProtectObjects>False</ProtectObjects>
   <ProtectScenarios>False</ProtectScenarios>
  </WorksheetOptions>
 </Worksheet>
</Workbook>
