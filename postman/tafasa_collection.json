            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Chocolate Cake\",\n  \"description\": \"Rich chocolate layer cake\",\n  \"price\": 12.50,\n  \"image\": \"https://example.com/cake.jpg\",\n  \"categoryId\": 1,\n  \"ingredients\": [\n    { \"name\": \"Flour\", \"amount\": 2, \"unit\": \"cups\" },\n    { \"name\": \"Sugar\", \"amount\": 1.5, \"unit\": \"cups\" },\n    { \"name\": \"Cocoa Powder\", \"amount\": 0.75, \"unit\": \"cups\" }\n  ],\n  \"preparationSteps\": [\n    { \"step\": 1, \"description\": \"Preheat oven to 180°C (350°F).\" },\n    { \"step\": 2, \"description\": \"Mix dry ingredients together.\" },\n    { \"step\": 3, \"description\": \"Bake for 30 minutes.\" }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
